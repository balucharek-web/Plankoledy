rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidLatLng(loc) {
      return loc is map
        && loc.keys().hasAll(['lat', 'lng'])
        && loc.keys().hasOnly(['lat', 'lng'])
        && loc.lat is number && loc.lat >= -90 && loc.lat <= 90
        && loc.lng is number && loc.lng >= -180 && loc.lng <= 180;
    }

    function isValidBoundary(boundary) {
      return boundary is list
        && boundary.size() <= 100
        && (boundary.size() == 0 || isValidLatLng(boundary[0]));
    }

    function isValidMemberUids(uids) {
      return uids is list
        && uids.size() <= 10
        && (uids.size() == 0 || (uids[0] is string && isValidId(uids[0])));
    }

    function isValidInvitedEmails(emails) {
      return emails is list
        && emails.size() <= 10
        && (emails.size() == 0 || (emails[0] is string && emails[0].size() >= 3 && emails[0].size() <= 200));
    }

    function isValidPlanConfig(cfg) {
      return cfg is map
        && cfg.keys().hasAll(['priestCount', 'startTime', 'defaultVisitMinutes', 'travelMode', 'returnToParish'])
        && cfg.keys().hasOnly(['priestCount', 'startTime', 'defaultVisitMinutes', 'travelMode', 'returnToParish'])
        && cfg.priestCount is number && cfg.priestCount >= 1 && cfg.priestCount <= 4
        && cfg.startTime is string && cfg.startTime.size() >= 4 && cfg.startTime.size() <= 10
        && cfg.defaultVisitMinutes is number && cfg.defaultVisitMinutes >= 1 && cfg.defaultVisitMinutes <= 240
        && cfg.travelMode in ['WALKING', 'DRIVING']
        && cfg.returnToParish is bool;
    }

    function isValidTimeStr(val) {
      return val is string && val.size() >= 4 && val.size() <= 5 && val.matches('^[0-9]{1,2}:[0-9]{2}$');
    }

    function isValidBreakWindow(bw) {
      return bw is map
        && bw.keys().hasAll(['id', 'startTime', 'endTime'])
        && bw.keys().hasOnly(['id', 'startTime', 'endTime', 'label'])
        && bw.id is string && bw.id.size() >= 1 && bw.id.size() <= 60
        && isValidTimeStr(bw.startTime)
        && isValidTimeStr(bw.endTime)
        && (!('label' in bw) || (bw.label is string && bw.label.size() <= 80));
    }

    function isValidPlanningRules(pr) {
      return pr is map
        && pr.keys().hasOnly(['splitMode', 'zoneDirection', 'blockPreference', 'safetyBufferMinutes'])
        && (!('splitMode' in pr) || (pr.splitMode in ['whole_or_half', 'parity', 'strict_budget']))
        && (!('zoneDirection' in pr) || (pr.zoneDirection in ['clockwise', 'nearest_first', 'farthest_first']))
        && (!('blockPreference' in pr) || (pr.blockPreference in ['any', 'blocks_weekdays_houses_weekend']))
        && (!('safetyBufferMinutes' in pr) || (pr.safetyBufferMinutes is number && pr.safetyBufferMinutes >= 0 && pr.safetyBufferMinutes <= 120));
    }

    function isValidSeasonConfig(sc) {
      return sc is map
        && sc.keys().hasAll(['startDate', 'weekdayStartTime', 'weekendStartTime', 'dailyEndTime', 'weekdaysMask'])
        && sc.keys().hasOnly(['startDate', 'endDate', 'weekdayStartTime', 'saturdayStartTime', 'weekendStartTime', 'dailyEndTime', 'weekdaysMask', 'excludedDates', 'defaultBreaks', 'planningRules', 'dayTimeOverrides'])
        && sc.startDate is string && sc.startDate.size() == 10 && sc.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('endDate' in sc) || (sc.endDate is string && sc.endDate.size() == 10 && sc.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && isValidTimeStr(sc.weekdayStartTime)
        && (!('saturdayStartTime' in sc) || isValidTimeStr(sc.saturdayStartTime))
        && isValidTimeStr(sc.weekendStartTime)
        && isValidTimeStr(sc.dailyEndTime)
        && sc.weekdaysMask is string && sc.weekdaysMask.size() <= 20 && sc.weekdaysMask.matches('^[0-6,]*$')
        && (!('excludedDates' in sc) || (sc.excludedDates is list && sc.excludedDates.size() <= 150 && (sc.excludedDates.size() == 0 || (sc.excludedDates[0] is string && sc.excludedDates[0].size() == 10))))
        && (!('defaultBreaks' in sc) || (sc.defaultBreaks is list && sc.defaultBreaks.size() <= 10 && (sc.defaultBreaks.size() == 0 || isValidBreakWindow(sc.defaultBreaks[0]))))
        && (!('planningRules' in sc) || isValidPlanningRules(sc.planningRules))
        && (!('dayTimeOverrides' in sc) || (sc.dayTimeOverrides is map && sc.dayTimeOverrides.size() <= 150));
    }

    function isValidParish(data) {
      return data.keys().hasAll(['ownerId', 'name', 'address', 'location', 'boundary', 'config', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'address', 'placeId', 'location', 'boundary', 'config', 'seasonConfig', 'memberUids', 'invitedEmails', 'createdAt', 'updatedAt'])
        && data.ownerId is string && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.address is string && data.address.size() <= 350
        && (!('placeId' in data) || (data.placeId is string && data.placeId.size() <= 250))
        && isValidLatLng(data.location)
        && isValidBoundary(data.boundary)
        && isValidPlanConfig(data.config)
        && (!('seasonConfig' in data) || isValidSeasonConfig(data.seasonConfig))
        && (!('memberUids' in data) || isValidMemberUids(data.memberUids))
        && (!('invitedEmails' in data) || isValidInvitedEmails(data.invitedEmails))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidParishInvite(data) {
      return data.keys().hasAll(['ownerId', 'parishId', 'parishName', 'invitedEmail', 'role', 'priestId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'ownerEmail', 'parishId', 'parishName', 'invitedEmail', 'role', 'priestId', 'memberLabel', 'status', 'memberUid', 'createdAt', 'updatedAt'])
        && data.ownerId is string && isValidId(data.ownerId)
        && (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 200))
        && data.parishId is string && isValidId(data.parishId)
        && data.parishName is string && data.parishName.size() >= 1 && data.parishName.size() <= 200
        && data.invitedEmail is string && data.invitedEmail.size() >= 3 && data.invitedEmail.size() <= 200
        && data.role == 'wikariusz'
        && data.priestId is number && data.priestId >= 1 && data.priestId <= 4
        && (!('memberLabel' in data) || (data.memberLabel is string && data.memberLabel.size() <= 120))
        && data.status in ['pending', 'accepted', 'revoked']
        && (!('memberUid' in data) || (data.memberUid is string && data.memberUid.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBuildingUnit(u) {
      return u is map
        && u.keys().hasAll(['id', 'unitNumber'])
        && u.keys().hasOnly(['id', 'unitNumber', 'staircase', 'familyName', 'notes', 'status', 'lastYearStatus', 'durationMinutes'])
        && u.id is string && u.id.size() >= 1 && u.id.size() <= 80
        && u.unitNumber is string && u.unitNumber.size() >= 1 && u.unitNumber.size() <= 30
        && (!('staircase' in u) || (u.staircase is string && u.staircase.size() <= 30))
        && (!('familyName' in u) || (u.familyName is string && u.familyName.size() <= 120))
        && (!('notes' in u) || (u.notes is string && u.notes.size() <= 200))
        && (!('status' in u) || (u.status in ['pending', 'accepted', 'absent', 'declined', 'invited']))
        && (!('lastYearStatus' in u) || (u.lastYearStatus in ['pending', 'accepted', 'absent', 'declined', 'invited']))
        && (!('durationMinutes' in u) || (u.durationMinutes is number && u.durationMinutes >= 1 && u.durationMinutes <= 120));
    }

    function isValidUnitsList(units) {
      return units is list
        && units.size() <= 200
        && (units.size() == 0 || isValidBuildingUnit(units[0]));
    }

    function isValidVisitStop(data, parishId) {
      return data.keys().hasAll(['ownerId', 'parishId', 'label', 'address', 'location', 'durationMinutes', 'priestId', 'inBoundary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'parishId', 'label', 'address', 'placeId', 'location', 'durationMinutes', 'priestId', 'inBoundary', 'included', 'visitDate', 'notes', 'isMultiUnit', 'unitsCount', 'minutesPerUnit', 'units', 'visitStatus', 'lastYearStatus', 'permanentDecline', 'manualOrder', 'createdAt', 'updatedAt'])
        && data.ownerId is string && isValidId(data.ownerId)
        && data.parishId is string && isValidId(data.parishId) && data.parishId == parishId
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 250
        && data.address is string && data.address.size() >= 1 && data.address.size() <= 350
        && (!('placeId' in data) || (data.placeId is string && data.placeId.size() <= 250))
        && isValidLatLng(data.location)
        && data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 1440
        && data.priestId is number && data.priestId >= 1 && data.priestId <= 4
        && data.inBoundary is bool
        && (!('included' in data) || data.included is bool)
        && (!('visitDate' in data) || (data.visitDate is string && data.visitDate.size() <= 10))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('isMultiUnit' in data) || data.isMultiUnit is bool)
        && (!('unitsCount' in data) || (data.unitsCount is number && data.unitsCount >= 0 && data.unitsCount <= 500))
        && (!('minutesPerUnit' in data) || (data.minutesPerUnit is number && data.minutesPerUnit >= 1 && data.minutesPerUnit <= 60))
        && (!('units' in data) || isValidUnitsList(data.units))
        && (!('visitStatus' in data) || (data.visitStatus in ['pending', 'accepted', 'absent', 'declined', 'invited']))
        && (!('lastYearStatus' in data) || (data.lastYearStatus in ['pending', 'accepted', 'absent', 'declined', 'invited']))
        && (!('permanentDecline' in data) || data.permanentDecline is bool)
        && (!('manualOrder' in data) || (data.manualOrder is number && data.manualOrder >= 0 && data.manualOrder <= 10000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isParishMemberData(data) {
      return data.ownerId == request.auth.uid
        || ('memberUids' in data && request.auth.uid in data.memberUids);
    }

    function isParishOwner(parishId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/parishes/$(parishId))
        && get(/databases/$(database)/documents/parishes/$(parishId)).data.ownerId == request.auth.uid;
    }

    function isParishMember(parishId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/parishes/$(parishId))
        && isParishMemberData(get(/databases/$(database)/documents/parishes/$(parishId)).data);
    }

    match /parishes/{parishId} {
      allow get: if isSignedIn()
        && isValidId(parishId)
        && (resource == null || isParishMemberData(existing()));
      allow list: if isSignedIn()
        && isParishMemberData(existing());
      allow create: if isVerifiedUser()
        && isValidId(parishId)
        && isValidParish(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(parishId)
        && isValidParish(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Proboszcz (Owner)
          (existing().ownerId == request.auth.uid && (
            incoming().diff(existing()).affectedKeys().hasOnly(['boundary', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['config', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['seasonConfig', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['invitedEmails', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['invitedEmails', 'memberUids', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'placeId', 'location', 'boundary', 'config', 'seasonConfig', 'updatedAt'])
          ))
          // Tier 2a: Verified invitee joining memberUids
          || ('invitedEmails' in existing()
            && request.auth.token.email is string
            && request.auth.token.email.lower() in existing().invitedEmails
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            && 'memberUids' in incoming()
            && request.auth.uid in incoming().memberUids
            && (!('memberUids' in existing())
              ? incoming().memberUids.size() == 1
              : (incoming().memberUids.hasAll(existing().memberUids) && incoming().memberUids.size() <= existing().memberUids.size() + 1)))
          // Tier 2b: Accepted Wikariusz leaving shared parish
          || ('memberUids' in existing()
            && request.auth.uid in existing().memberUids
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            && 'memberUids' in incoming()
            && !(request.auth.uid in incoming().memberUids)
            && existing().memberUids.hasAll(incoming().memberUids)
            && incoming().memberUids.size() == existing().memberUids.size() - 1)
        );
      allow delete: if isVerifiedUser()
        && isValidId(parishId)
        && existing().ownerId == request.auth.uid;

      match /stops/{stopId} {
        allow get: if isSignedIn()
          && isValidId(parishId)
          && isValidId(stopId)
          && (resource == null || existing().ownerId == request.auth.uid || isParishMember(parishId))
          && isParishMember(parishId);
        allow list: if isSignedIn()
          && isValidId(parishId)
          && (existing().ownerId == request.auth.uid || isParishMember(parishId));
        allow create: if isVerifiedUser()
          && isValidId(parishId)
          && isValidId(stopId)
          && isValidVisitStop(incoming(), parishId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isParishOwner(parishId);
        allow update: if isVerifiedUser()
          && isValidId(parishId)
          && isValidId(stopId)
          && isValidVisitStop(incoming(), parishId)
          && incoming().ownerId == existing().ownerId
          && incoming().parishId == existing().parishId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Tier 1: Proboszcz (Owner) full schedule & stop editing
            (existing().ownerId == request.auth.uid
              && isParishOwner(parishId)
              && (
                incoming().diff(existing()).affectedKeys().hasOnly(['priestId', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['inBoundary', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['included', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['visitDate', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['visitStatus', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['manualOrder', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['visitDate', 'priestId', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['visitDate', 'priestId', 'included', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['visitDate', 'priestId', 'included', 'manualOrder', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['visitStatus', 'lastYearStatus', 'permanentDecline', 'visitDate', 'included', 'manualOrder', 'units', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['label', 'address', 'durationMinutes', 'priestId', 'inBoundary', 'included', 'visitDate', 'notes', 'isMultiUnit', 'unitsCount', 'minutesPerUnit', 'units', 'visitStatus', 'lastYearStatus', 'permanentDecline', 'manualOrder', 'updatedAt'])
              ))
            // Tier 2: Wikariusz (Collaborator) field-visit updates ONLY
            || (isParishMember(parishId)
              && (
                incoming().diff(existing()).affectedKeys().hasOnly(['visitStatus', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['visitStatus', 'notes', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['units', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['units', 'visitStatus', 'notes', 'updatedAt'])
                || incoming().diff(existing()).affectedKeys().hasOnly(['units', 'durationMinutes', 'updatedAt'])
              ))
          );
        allow delete: if isVerifiedUser()
          && isValidId(parishId)
          && isValidId(stopId)
          && existing().ownerId == request.auth.uid
          && isParishOwner(parishId);
      }
    }

    match /parishInvites/{inviteId} {
      allow get: if isVerifiedUser()
        && isValidId(inviteId)
        && (
          resource == null
          || existing().ownerId == request.auth.uid
          || (request.auth.token.email is string && existing().invitedEmail == request.auth.token.email.lower())
          || ('memberUid' in existing() && existing().memberUid == request.auth.uid)
        );
      allow list: if isVerifiedUser()
        && (
          existing().ownerId == request.auth.uid
          || (request.auth.token.email is string && existing().invitedEmail == request.auth.token.email.lower())
        );
      allow create: if isVerifiedUser()
        && isValidId(inviteId)
        && isValidParishInvite(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isParishOwner(incoming().parishId);
      allow update: if isVerifiedUser()
        && isValidId(inviteId)
        && isValidParishInvite(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().parishId == existing().parishId
        && incoming().invitedEmail == existing().invitedEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Proboszcz revokes or updates slot/label on non-revoked invite
          (existing().ownerId == request.auth.uid
            && existing().status != 'revoked'
            && (
              (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'revoked')
              || incoming().diff(existing()).affectedKeys().hasOnly(['priestId', 'memberLabel', 'updatedAt'])
            ))
          // Verified invitee accepts pending invite
          || (existing().status == 'pending'
            && request.auth.token.email is string
            && existing().invitedEmail == request.auth.token.email.lower()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'memberUid', 'updatedAt'])
            && incoming().status == 'accepted'
            && incoming().memberUid == request.auth.uid)
          // Verified invitee declines pending invite or marks left
          || ((existing().status == 'pending' || existing().status == 'accepted')
            && request.auth.token.email is string
            && existing().invitedEmail == request.auth.token.email.lower()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().status == 'revoked')
        );
      allow delete: if isVerifiedUser()
        && isValidId(inviteId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
